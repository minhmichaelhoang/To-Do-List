{
	"name": "practice-multithreading",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"start": "npm run start --workspace=backend",
		"start:server": "npm run start:server --workspace=backend",
		"dev": "npm run dev --workspace=frontend",
		"check:naming": "node scripts/check-file-naming.mjs",
		"check:docs": "eslint .",
		"test": "vitest run",
		"check:coverage": "vitest run --coverage",
		"prepare": "husky || true"
	},
	"workspaces": [
		"backend",
		"frontend",
		"shared"
	],
	"devDependencies": {
		"@typescript-eslint/parser": "^8.67.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.0",
		"eslint-plugin-jsdoc": "^64.2.1",
		"husky": "^9.1.7",
		"prettier": "^3.9.6",
		"vitest": "^4.1.11"
	}
}
